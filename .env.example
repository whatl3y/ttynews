# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000
# PUBLIC ORIGIN - emitted verbatim as <link rel=canonical>, og:url, JSON-LD, and
# the robots.txt Sitemap: line on every page. In production this MUST be your
# canonical https:// origin (e.g. https://tty.news); the app
# refuses to boot when NODE_ENV=production and HOST is missing or not https,
# because a localhost/http value silently deindexes the whole site. No trailing slash.
HOST=http://localhost:8000
LOG_LEVEL=info
# Number of trusted proxy hops in front of the app (Heroku router = 1).
# MUST be a hop count - never "true" - so req.ip can't be spoofed via X-Forwarded-For.
TRUST_PROXY_HOPS=1

# ── Redis (required for caching; app degrades to direct fetches without it) ─
REDIS_URL=redis://localhost:6379

# ── IP geolocation (GET / redirect) ─────────────────────────────────────────
# Free MaxMind account: https://www.maxmind.com/en/geolite2/signup
# With both set, `pnpm download-geolite` fetches data/GeoLite2-City.mmdb
# (~60-70MB; MaxMind refreshes it Tue/Fri - re-run periodically).
# If the .mmdb file is absent the app falls back to the keyless https://ipwho.is
# API (~1,000 req/day, results cached 24h per IP).
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
GEOLITE_MMDB_PATH=data/GeoLite2-City.mmdb
# Fallback zip when IP geolocation can't resolve a US zip (private IPs in local
# dev, or non-US / unknown IPs in production). Root always lands on a populated
# page rather than a bare entry form. Set to empty to force the landing page.
DEFAULT_ZIP=10001

# ── Zip database (vendored in repo; refresh with `pnpm refresh-zips`) ───────
# GeoNames US postal data, CC BY 4.0.
ZIP_DATA_PATH=data/US.txt

# ── Global place gazetteer (fetch with `pnpm refresh-places`) ──────────────
# Non-US cities (geonameId-keyed) + GeoNames reference tables. Absent → US-only mode.
CITIES_DATA_PATH=data/cities500.txt
ADMIN1_PATH=data/admin1Codes.txt
ADMIN2_PATH=data/admin2Codes.txt
COUNTRY_INFO_PATH=data/countryInfo.txt
# Non-US homepage fallback when an IP can't be resolved (US uses DEFAULT_ZIP).
DEFAULT_PLACE_QUERY="London, GB"

# ── Upstream sources ────────────────────────────────────────────────────────
# api.weather.gov requires a contact-identifying User-Agent (alerts + weather fallback).
NWS_USER_AGENT="ttynews/1.0 (you@example.com)"
# Per-source fetch timeout in ms; one slow upstream never blocks the page longer than this.
SOURCE_TIMEOUT_MS=4000
# AirNow air quality - free key: https://docs.airnowapi.org (500 req/hr).
# Absent → keyless Open-Meteo air-quality fallback is used instead.
AIRNOW_API_KEY=
# Ticketmaster Discovery v2 - free key: https://developer.ticketmaster.com (5k req/day).
# Merged with SeatGeek into the events widget; widget hides only if BOTH are absent.
TICKETMASTER_API_KEY=
# SeatGeek Platform API - free self-serve client_id: https://seatgeek.com/account/develop
# (no published rate limit). Complements Ticketmaster in the events widget.
SEATGEEK_CLIENT_ID=
# Foursquare FSQ Places API - free service key: https://foursquare.com/developers
# (free tier is 500 calls/MONTH - cached 24h/zip). Powers the "Food & Drink Nearby" widget.
FOURSQUARE_API_KEY=
# Hard monthly cap on Foursquare cold fetches across the whole server (places +
# intl parks/camps share the account's 500/mo). Default 450 leaves headroom; once
# spent, those widgets hide until the month resets. See libs/budget.
FOURSQUARE_MONTHLY_BUDGET=450
# National Park Service - free key: https://www.nps.gov/subjects/developer/get-started.htm
# (1000 req/hr). Powers the "Parks" widget (national parks in your state, nearest first).
NPS_API_KEY=
# Recreation.gov RIDB - free key: https://ridb.recreation.gov/profile (log in → API key).
# (50 req/min). Powers the "Campgrounds" widget (within 25 miles).
RIDB_API_KEY=
# Google Pollen API - key from Google Cloud Console (Maps Platform). Requires a billing
# account with a card even for the free 5,000 calls/month. Powers the "Pollen" widget.
GOOGLE_POLLEN_API_KEY=
# Google Civic Information API - key from Google Cloud Console (no billing/card needed;
# 25k req/day). Powers the "Election" widget (hidden unless an election is upcoming).
GOOGLE_CIVIC_API_KEY=

# ── LLM summary (optional) ──────────────────────────────────────────────────
# Absent → the 2-3 sentence local summary is skipped silently; widgets still render.
ANTHROPIC_API_KEY=
LLM_SUMMARY_MODEL=claude-haiku-4-5
LLM_SUMMARY_MAX_TOKENS=300

# ── Caching ─────────────────────────────────────────────────────────────────
# Whole-page bundle cache TTL in seconds (0 disables; per-source caches always apply).
PAGE_BUNDLE_TTL_SECONDS=90

# ── Priority-zip warmer ─────────────────────────────────────────────────────
# Crawlers run cache-only (they never trigger an upstream fetch), so a zip nobody
# has warmed would be indexed thin. This background loop keeps the hottest zips'
# caches warm - the ones real visitors view - so crawlers land on rich pages.
# See tasks/warmZips + libs/warmSet.
#
# Enabled by default in production (NODE_ENV=production), off elsewhere so a dev
# run can't spend Foursquare/LLM quota. Set true/false to override either way.
WARM_ENABLED=
# How many of the hottest zips to warm each cycle (free upstreams: weather/news/…).
WARM_TOP_ZIPS=40
# Of those, how many ALSO warm the metered sources (Foursquare venues + the AI
# bulletin). Keep small so the warmer's Foursquare spend stays well under the
# monthly cap: ~this many calls/day (24h places cache). 0 = warm free sources only.
WARM_METERED_ZIPS=12
# Warm the AI bulletin (Anthropic) for the metered tier too. false = skip it.
WARM_SUMMARY=true
# Seconds between warm cycles (min 60). 600 (10 min) tracks the weather TTL.
WARM_INTERVAL_MS=600000

//- Header pieces: status bar, masthead, location form, current-weather glance.

mixin statusBar(place, now)
  .status-bar(aria-hidden="true")
    span.sb-name= siteName
    span.sb-place= place.locationLine.toUpperCase()
    span.sb-date= now.date

mixin masthead(art)
  h1.sr-only= siteName
  pre.masthead(aria-hidden="true")= art

//- Home › Region › City trail. Real anchors - internal links + a Breadcrumb rich result.
mixin breadcrumb(crumbs)
  nav.crumbs(aria-label="Breadcrumb")
    each c, i in crumbs
      if i > 0
        span.crumb-sep(aria-hidden="true") ›
      if c.href
        a(href=c.href)= c.name
      else if i === crumbs.length - 1
        span.crumb-current= c.name
      else
        span= c.name

mixin zipForm(zip)
  form.zip-form(action="/" method="get")
    label(for="zip-input") guest@tty:$
    input#zip-input(
      type="text"
      name="q"
      autocomplete="off"
      autocapitalize="words"
      maxlength="64"
      placeholder="postal code or city"
      aria-label="Enter a postal code or a city and country"
    )
    button(type="submit") Enter

//- Units + language toggles. Links to /prefs (sets a cookie, 302s back), so the
//- page works with JS disabled and canonical URLs stay clean of query params.
mixin prefsBar(langOptions, unitsMetric, path)
  .prefs-bar(aria-label="Display preferences")
    span.prefs-group
      a(href="/prefs?units=imperial&next=" + encodeURIComponent(path) class=(unitsMetric ? null : 'rv') rel="nofollow") °F
      a(href="/prefs?units=metric&next=" + encodeURIComponent(path) class=(unitsMetric ? 'rv' : null) rel="nofollow") °C
    if langOptions && langOptions.length > 1
      span.prefs-group
        each o in langOptions
          a(href="/prefs?lang=" + o.code + "&next=" + encodeURIComponent(path) class=(o.current ? 'rv' : null) rel="nofollow" hreflang=o.code)= o.name

mixin currentWx(current, now, place)
  .glance
    if current
      +asciiArt(current.icon)
      div
        .glance-temp= current.temp
        .glance-cond= current.condition
      .glance-meta
        if current.feelsLike
          div FEELS #{current.feelsLike}
        if current.wind
          div WIND #{current.wind}
        if current.humidityPct != null
          div HUMID #{current.humidityPct}%
      .glance-meta
        if current.sunrise
          div ↑ #{current.sunrise}
        if current.sunset
          div ↓ #{current.sunset}
        if current.moonPhaseName
          div= current.moonPhaseName
    .glance-clock
      .clock-time.cursor#clock(data-tz=place.timezone)= now.time
      div #{now.tzAbbr} · LOCAL TIME
